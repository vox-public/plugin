{
  "name": "get_work_record",
  "inputSchema": {
    "type": "object",
    "properties": {
      "record_type": {
        "enum": [
          "list",
          "case",
          "events",
          "proposals",
          "runs"
        ],
        "description": "조회 종류. list: 접근 가능한 개인·agent case 목록(case_id 금지). case: case_id의 단일 case 상세(case_id 필수). events|proposals|runs: case_id의 이벤트·제안·run 목록(case_id 필수)."
      },
      "agent_id": {
        "type": "string",
        "format": "uuid",
        "description": "record_type=list에서만 선택적으로 agent를 좁힙니다."
      },
      "case_id": {
        "type": "string",
        "format": "uuid",
        "description": "record_type이 case, events, proposals, runs이면 필수이고 list에서는 사용할 수 없습니다."
      },
      "cursor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "description": "record_type이 list, events, proposals, runs일 때 다음 페이지 cursor. case에서는 사용할 수 없습니다."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20,
        "description": "record_type이 list, events, proposals, runs일 때 페이지 크기(1-20). case에서는 사용할 수 없습니다."
      },
      "claim_cursor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "description": "record_type=case에서만 claim 다음 페이지 cursor."
      },
      "evidence_cursor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "description": "record_type=case에서만 evidence 다음 페이지 cursor."
      }
    },
    "required": [
      "record_type"
    ],
    "additionalProperties": false
  }
}
