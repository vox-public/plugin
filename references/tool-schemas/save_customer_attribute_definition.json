              "description": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Description",
                "description": "Attribute description."
              },
              "enum_options": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Enum Options",
                "description": "Allowed string values for the `enum` type. Cannot be specified for other types."
              },
              "conflict_mode": {
                "type": "string",
