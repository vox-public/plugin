{
  "name": "save_work_record",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "enum": [
          "create",
          "event",
          "delete_case",
          "delete_source"
        ],
        "description": "create: 새 case 생성(payload=case 입력, case_id·source_id 금지). event: 기존 case에 event 추가(case_id 필수, payload=event 입력, source_id 금지). delete_case: case 삭제(case_id 필수, source_id 금지). delete_source: source 삭제(source_id 필수, case_id 금지)."
      },
      "case_id": {
        "type": "string",
        "format": "uuid",
        "description": "action이 event 또는 delete_case이면 필수이고 create, delete_source에서는 사용할 수 없습니다."
      },
      "source_id": {
        "type": "string",
        "format": "uuid",
        "description": "action=delete_source에서만 필수이고 다른 action에서는 사용할 수 없습니다."
      },
      "payload": {
        "anyOf": [
          {
            "$ref": "#/$defs/AutomaticImprovementCaseCreateInput"
          },
          {
            "$ref": "#/$defs/AutomaticImprovementEventAppendInput"
          },
          {
            "$ref": "#/$defs/ImprovementEventAppendInput"
          },
          {
            "$ref": "#/$defs/ImprovementDeleteInput"
          },
          {
            "$ref": "#/$defs/ImprovementSourceDeleteInput"
          }
        ],
        "description": "action에 맞는 입력입니다. create는 case 생성, event는 routine 또는 case 관리 event, delete_*는 삭제 입력입니다."
      }
    },
    "required": [
      "action",
      "payload"
    ],
    "additionalProperties": false,
    "$defs": {
      "ImprovementSourceInput": {
        "additionalProperties": false,
        "description": "Caller-provided source locator; repository validation owns its meaning.",
        "properties": {
          "source_host": {
            "enum": [
              "embedded",
              "codex",
              "claude",
              "api"
            ],
            "title": "Source Host",
            "type": "string"
          },
          "source_thread_id": {
            "anyOf": [
              {
                "maxLength": 36,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source Thread Id"
          },
          "host_session_ref": {
            "anyOf": [
              {
                "maxLength": 256,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Host Session Ref"
          },
          "source_message_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source Message Id"
          },
          "source_artifact_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source Artifact Id"
          },
          "source_sha256": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 64,
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source Sha256"
          },
          "observed_at": {
            "maximum": 253402300799999,
            "minimum": 0,
            "title": "Observed At",
            "type": "integer"
          },
          "explicit_quote": {
            "anyOf": [
              {
                "maxLength": 4096,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Explicit Quote"
          }
        },
        "required": [
          "source_host",
          "observed_at"
        ],
        "title": "ImprovementSourceInput",
        "type": "object"
      },
      "ImprovementCaseCreateInput": {
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "format": "uuid",
            "title": "Operation Id",
            "type": "string"
          },
          "agent_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Agent Id"
          },
          "expected_agent_head_revision": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Expected Agent Head Revision"
          },
          "goal": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Goal",
            "type": "string"
          },
          "success_criteria": {
            "default": "",
            "maxLength": 4096,
            "title": "Success Criteria",
            "type": "string"
          },
          "source": {
            "$ref": "#/$defs/ImprovementSourceInput"
          }
        },
        "required": [
          "operation_id",
          "goal",
          "source"
        ],
        "title": "ImprovementCaseCreateInput",
        "type": "object"
      },
      "AutomaticImprovementCaseCreateInput": {
        "additionalProperties": false,
        "description": "Typed case command guarded by the current background settings version.",
        "properties": {
          "operation_id": {
            "format": "uuid",
            "title": "Operation Id",
            "type": "string"
          },
          "agent_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Agent Id"
          },
          "expected_agent_head_revision": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Expected Agent Head Revision"
          },
          "goal": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Goal",
            "type": "string"
          },
          "success_criteria": {
            "default": "",
            "maxLength": 4096,
            "title": "Success Criteria",
            "type": "string"
          },
          "source": {
            "$ref": "#/$defs/ImprovementSourceInput"
          },
          "expected_settings_revision": {
            "minimum": 1,
            "title": "Expected Settings Revision",
            "type": "integer",
            "description": "Copy this value from the latest get_work_context.data.background_settings. The API accepts the write only while background processing remains enabled at this exact revision/epoch."
          },
          "expected_settings_epoch": {
            "minimum": 1,
            "title": "Expected Settings Epoch",
            "type": "integer",
            "description": "Copy this value from the latest get_work_context.data.background_settings. The API accepts the write only while background processing remains enabled at this exact revision/epoch."
          }
        },
        "required": [
          "operation_id",
          "goal",
          "source",
          "expected_settings_revision",
          "expected_settings_epoch"
        ],
        "title": "AutomaticImprovementCaseCreateInput",
        "type": "object"
      },
