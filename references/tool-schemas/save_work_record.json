              {
                "$ref": "#/$defs/ClaimCorrectedPayload"
              },
              {
                "$ref": "#/$defs/VisibilityChangedPayload"
              },
              {
                "$ref": "#/$defs/ProposalAcceptedPayload"
              },
              {
                "$ref": "#/$defs/CaseUpdatedPayload"
              },
              {
                "$ref": "#/$defs/RunCancelledPayload"
              }
            ],
            "title": "Payload"
          }
        },
        "required": [
          "expected_version",
          "operation_id",
          "source",
          "payload"
        ],
        "title": "ImprovementEventAppendInput",
        "type": "object"
      },
