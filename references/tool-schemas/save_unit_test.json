{
  "name": "save_unit_test",
  "inputSchema": {
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "type": "string",
            "const": "create"
          },
          "payload": {
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 255,
                "minLength": 1,
                "title": "Name",
                "description": "테스트 이름입니다."
              },
              "description": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Description",
                "description": "테스트 설명입니다. null이면 설명이 없습니다."
              },
              "messages": {
                "items": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/UnitTestUserMessage"
                    },
                    {
                      "$ref": "#/$defs/UnitTestAgentMessage"
                    },
                    {
                      "$ref": "#/$defs/UnitTestToolCallInvocation"
                    },
                    {
                      "$ref": "#/$defs/UnitTestToolCallResult"
                    }
                  ],
                  "discriminator": {
                    "propertyName": "role",
                    "mapping": {
                      "agent": "#/components/schemas/UnitTestAgentMessage",
                      "tool_call_invocation": "#/components/schemas/UnitTestToolCallInvocation",
                      "tool_call_result": "#/components/schemas/UnitTestToolCallResult",
                      "user": "#/components/schemas/UnitTestUserMessage"
                    }
                  }
                },
                "type": "array",
                "minItems": 1,
                "title": "Messages",
                "description": "검사할 대화입니다. 통화 transcript와 같은 항목을 순서대로 쓰고 마지막 항목에 `eval`로 기대 행동을 지정합니다. 규칙에 맞지 않는 초안도 저장되며 `validation`에 문제가 표시되고 실행할 수 없습니다. 항목에 정의되지 않은 키는 저장하지 않고 무시하지만 `eval` 안에는 정의된 키만 쓸 수 있습니다.",
                "examples": [
                  [
                    {
                      "content": "예약 바꾸려고요",
                      "role": "user"
                    },
                    {
                      "arguments": {
                        "phone": "01012345678"
                      },
                      "name": "lookup_booking",
                      "role": "tool_call_invocation",
                      "tool_call_id": "c1"
                    },
                    {
                      "content": "{\"date\": \"11-03\"}",
                      "role": "tool_call_result",
                      "tool_call_id": "c1"
                    },
                    {
                      "content": "11월 3일 예약 확인했어요. 언제로 바꿔 드릴까요?",
                      "eval": {
                        "expected_behavior": "확인한 예약 날짜를 말하고 바꿀 날짜를 묻는다"
                      },
                      "role": "agent"
                    }
                  ]
                ]
              },
              "flow_agent_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Flow Agent Id",
                "description": "Flow 유닛 테스트가 속한 Flow 에이전트 id입니다. `flow_start_node_id`와 함께 지정합니다. 정한 뒤에는 바꿀 수 없습니다."
              },
              "flow_start_node_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Flow Start Node Id",
                "description": "Flow 유닛 테스트를 시작할 노드 id입니다. `flow_agent_id`와 함께 지정합니다."
              },
              "dynamic_variables": {
                "anyOf": [
                  {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Dynamic Variables",
                "description": "실행할 때 에이전트에 넣을 동적 변수입니다."
              },
              "tool_mocks": {
                "anyOf": [
                  {
                    "items": {
                      "oneOf": [
                        {
                          "$ref": "#/$defs/EvalApiToolMock"
                        },
                        {
                          "$ref": "#/$defs/EvalMcpToolMock"
                        },
                        {
                          "$ref": "#/$defs/EvalFlowApiToolMock"
                        }
                      ],
                      "discriminator": {
                        "propertyName": "type",
                        "mapping": {
                          "api": "#/components/schemas/EvalApiToolMock",
                          "flow_api": "#/components/schemas/EvalFlowApiToolMock",
                          "mcp": "#/components/schemas/EvalMcpToolMock"
                        }
                      }
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Tool Mocks",
                "description": "실행할 때 실제 도구 대신 쓸 mock 응답입니다. 같은 도구나 Flow 노드는 한 번만 지정합니다. null이면 mock이 없습니다."
              },
              "metadata": {
                "anyOf": [
                  {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Metadata",
                "description": "테스트에 붙여 두는 사용자 정의 정보입니다. 실행에는 쓰이지 않습니다."
              }
            },
            "type": "object",
            "required": [
              "name",
              "messages"
            ],
            "title": "CreateUnitTestRequest",
            "additionalProperties": false,
            "examples": [
              {
                "name": "예약 변경 안내",
                "messages": [
                  {
                    "role": "user",
                    "content": "예약 바꾸려고요"
                  },
                  {
                    "role": "tool_call_invocation",
                    "name": "lookup_booking",
                    "arguments": {
                      "phone": "01012345678"
                    }
                  },
                  {
                    "role": "tool_call_result",
                    "content": "{\"date\": \"11-03\"}"
                  },
                  {
                    "role": "agent",
                    "content": "11월 3일 예약 확인했어요. 언제로 바꿔 드릴까요?",
                    "eval": {
                      "expected_behavior": "확인한 예약 날짜를 말하고 바꿀 날짜를 묻는다"
                    }
                  }
                ]
              }
            ]
          }
        },
        "required": [
          "mode",
          "payload"
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "type": "string",
            "const": "update"
          },
          "test_id": {
            "type": "string",
