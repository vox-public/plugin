{
  "name": "create_chat_message",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "chat_id": {
        "type": "string",
        "format": "uuid",
        "description": "채팅 ID입니다.",
        "title": "Chat Id"
      },
      "payload": {
        "anyOf": [
          {
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "text"
            ]
          },
          {
            "properties": {
              "images": {
                "type": "array",
                "maxItems": 3,
                "minItems": 1
              }
            },
            "required": [
              "images"
            ]
          }
        ],
        "properties": {
          "text": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Text",
            "description": "사용자 메시지 텍스트입니다."
          },
          "images": {
            "anyOf": [
              {
                "items": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/ChatMessageFileKeyImageInput"
                    },
                    {
                      "$ref": "#/$defs/ChatMessageBase64ImageInput"
                    },
                    {
                      "$ref": "#/$defs/ChatMessageUrlImageInput"
                    }
                  ],
                  "discriminator": {
                    "propertyName": "type",
                    "mapping": {
                      "base64": "#/components/schemas/ChatMessageBase64ImageInput",
                      "file_key": "#/components/schemas/ChatMessageFileKeyImageInput",
                      "url": "#/components/schemas/ChatMessageUrlImageInput"
                    }
                  }
                },
                "type": "array",
                "maxItems": 3,
                "minItems": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Images",
            "description": "선택 이미지 입력입니다. 최대 3장까지 지원합니다."
          },
          "client_idempotency_key": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Client Idempotency Key",
            "description": "채팅 안에서 사용자 메시지를 식별하는 멱등 키입니다. 같은 키를 다시 보내면 에이전트 턴을 재실행하지 않고 저장된 결과를 반환합니다."
          }
        },
        "type": "object",
        "required": [
          "client_idempotency_key"
        ],
        "title": "CreateChatMessageRequest",
        "additionalProperties": false
      }
    },
    "required": [
      "chat_id",
      "payload"
    ],
    "$defs": {
      "ChatMessageFileKeyImageInput": {
        "properties": {
          "type": {
            "type": "string",
            "const": "file_key",
            "title": "Type",
            "description": "기존 업로드 파일 키를 사용하는 이미지 입력입니다."
          },
          "file_key": {
            "type": "string",
            "minLength": 1,
            "title": "File Key",
            "description": "`POST /files`에서 받은 기존 업로드 파일 키입니다.",
            "examples": [
              "file_abc123"
            ]
          }
        },
        "type": "object",
        "required": [
          "type",
          "file_key"
        ],
        "title": "ChatMessageFileKeyImageInput",
        "additionalProperties": false
      },
      "ChatMessageBase64ImageInput": {
        "properties": {
          "type": {
            "type": "string",
            "const": "base64",
            "title": "Type",
            "description": "base64 데이터를 직접 보내는 이미지 입력입니다."
          },
          "mime_type": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Mime Type",
            "description": "클라이언트가 선언한 MIME 타입입니다.",
            "examples": [
              "image/jpeg"
            ]
          },
          "data": {
            "type": "string",
            "minLength": 1,
            "title": "Data",
            "description": "base64 이미지 데이터입니다."
          }
        },
        "type": "object",
        "required": [
          "type",
          "data"
        ],
        "title": "ChatMessageBase64ImageInput",
        "additionalProperties": false
      },
      "ChatMessageUrlImageInput": {
        "properties": {
          "type": {
            "type": "string",
            "const": "url",
            "title": "Type",
            "description": "서버가 HTTPS URL에서 가져오는 이미지 입력입니다."
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "title": "Url",
            "description": "서버가 fetch할 HTTPS 이미지 URL입니다.",
            "examples": [
              "https://example.com/photo.jpg"
            ]
          }
        },
        "type": "object",
        "required": [
          "type",
          "url"
        ],
        "title": "ChatMessageUrlImageInput",
        "additionalProperties": false
      }
    }
  }
}
