            "const": "update"
          },
          "payload": {
            "properties": {
              "name": {
                "type": "string",
                "title": "Name",
                "description": "Attribute name. Omit to keep the current value."
              },
              "description": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Description",
                "description": "Attribute description. Omit to keep the current value."
              },
              "enum_options": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
