                "proposal_rejected": "#/$defs/ProposalRejectedPayload",
                "run_cancelled": "#/$defs/RunCancelledPayload",
                "source_retracted": "#/$defs/SourceRetractedPayload",
                "visibility_changed": "#/$defs/VisibilityChangedPayload"
              },
              "propertyName": "kind"
