                      ],
                      "discriminator": {
                        "propertyName": "type",
                        "mapping": {
                          "api": "#/components/schemas/EvalApiToolMock",
                          "flow_api": "#/components/schemas/EvalFlowApiToolMock",
                          "mcp": "#/components/schemas/EvalMcpToolMock"
                        }
                      }
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Tool Mocks",
                "description": "실행할 때 실제 도구 대신 쓸 mock 응답입니다. 같은 도구나 Flow 노드는 한 번만 지정합니다. null이면 mock이 없습니다."
              },
              "metadata": {
                "anyOf": [
                  {
                    "additionalProperties": true,
