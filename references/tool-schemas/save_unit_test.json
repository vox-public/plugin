    "$defs": {
      "UnitTestUserMessage": {
        "properties": {
          "role": {
            "type": "string",
            "const": "user",
            "title": "Role",
            "description": "고객 발화 항목입니다."
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "고객 발화 내용입니다."
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "UnitTestUserMessage"
      },
      "UnitTestAgentMessage": {
        "properties": {
          "role": {
            "type": "string",
            "const": "agent",
            "title": "Role",
            "description": "에이전트 응답 항목입니다."
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "에이전트 응답 내용입니다. 검사 지점이면 참고용 응답이며 비워 둘 수 있습니다."
          },
          "eval": {
            "anyOf": [
              {
                "$ref": "#/$defs/EvalAgentExpectation"
              },
              {
                "type": "null"
              }
            ],
            "description": "이 항목을 검사 지점으로 지정합니다. 마지막 항목에만 작성합니다."
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "UnitTestAgentMessage"
      },
      "EvalAgentExpectation": {
        "properties": {
          "expected_behavior": {
            "type": "string",
            "title": "Expected Behavior",
            "description": "이 지점에서 기대하는 에이전트 행동입니다. 판정 AI가 실제 응답을 이 문장과 비교합니다."
          },
          "to_node_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "To Node Id",
            "description": "Flow 유닛 테스트의 agent 검사 지점에서 기대하는 전환 목적지 노드 id로, 생략하면 전환이 아닌 응답을 기대합니다. Flow에서 null이나 빈 문자열은 목적지를 고르지 않은 초안으로 저장됩니다."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_behavior"
        ],
        "title": "EvalAgentExpectation"
      },
      "UnitTestToolCallInvocation": {
        "properties": {
          "role": {
            "type": "string",
            "const": "tool_call_invocation",
            "title": "Role",
            "description": "에이전트의 도구 호출 항목입니다."
          },
          "tool_call_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Call Id",
            "description": "도구 호출 id입니다. 생략하면 목록에서의 호출 순서로 `call_1`, `call_2`처럼 정합니다."
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "호출한 도구 이름입니다. eval이 없는 항목에서는 필수이며, Manual 이력은 정확히 `StartManual`로 작성합니다."
          },
          "arguments": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Arguments",
            "description": "도구 호출 인자 객체입니다. eval이 없는 항목에서는 필수이며, `StartManual`의 `id`에는 Manual UUID를 작성합니다."
          },
          "eval": {
            "anyOf": [
              {
                "$ref": "#/$defs/EvalToolCallExpectation"
              },
              {
                "type": "null"
              }
            ],
            "description": "이 자리에서 도구 호출을 기대하는 검사 지점으로, 마지막 항목에만 작성합니다. 어떤 도구를 어떤 인자로 부를지는 `expected_behavior`에 문장으로 씁니다."
          }
        },
        "type": "object",
        "required": [
          "role"
        ],
        "title": "UnitTestToolCallInvocation"
      },
      "EvalToolCallExpectation": {
        "properties": {
          "expected_behavior": {
            "type": "string",
            "title": "Expected Behavior",
            "description": "이 자리에서 기대하는 도구 호출입니다. 어떤 도구를 어떤 인자로 부를지 문장으로 쓰면 판정 AI가 실제 호출을 이 문장과 비교합니다."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_behavior"
        ],
        "title": "EvalToolCallExpectation"
      },
      "UnitTestToolCallResult": {
        "properties": {
          "role": {
            "type": "string",
            "const": "tool_call_result",
            "title": "Role",
            "description": "도구 호출 결과 항목입니다. 대응하는 tool_call_invocation 바로 다음에 둡니다."
          },
          "tool_call_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Call Id",
            "description": "대응하는 도구 호출 id입니다. 생략하면 바로 앞 호출의 id를 씁니다."
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "도구 결과 문자열입니다. `StartManual` 결과는 `status`가 loaded, already_loaded, rejected, error 중 하나인 JSON 객체 문자열입니다."
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "UnitTestToolCallResult"
      },
      "EvalApiToolMock": {
        "properties": {
          "type": {
            "type": "string",
            "const": "api",
            "title": "Type",
            "description": "API 도구 mock입니다."
          },
