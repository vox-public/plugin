{
  "name": "save_unit_test",
  "inputSchema": {
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "type": "string",
            "const": "create"
          },
          "payload": {
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 255,
                "minLength": 1,
                "title": "Name",
                "description": "테스트 이름입니다."
              },
              "description": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Description",
                "description": "테스트 설명입니다."
              },
              "messages": {
                "items": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/UnitTestJudgeMessage"
                    },
                    {
                      "$ref": "#/$defs/UnitTestAssistantMessage"
                    },
                    {
                      "$ref": "#/$defs/ChatEvalUserMessage"
                    },
                    {
                      "$ref": "#/$defs/ChatEvalToolResponseMessage"
                    }
                  ]
                },
                "type": "array",
                "minItems": 1,
                "title": "Messages",
                "description": "고정 대화 이력과 마지막 검사 하나입니다. Flow transition은 eval.to_node_id로 목적지를 지정합니다. 의미 규칙이 틀린 초안도 저장되지만 실행할 수 없습니다.",
                "examples": [
                  [
                    {
                      "content": "예약을 확인해 주세요.",
                      "role": "user"
                    },
                    {
                      "content": "",
                      "eval": {
                        "enabled": true,
                        "expected_behavior": "예약 조회로 전환한다.",
                        "expected_kind": "transition",
                        "to_node_id": "lookup-booking"
                      },
                      "role": "assistant"
                    }
                  ]
                ]
              },
              "flow_agent_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Flow Agent Id",
                "description": "Flow 정의의 소속 Agent UUID입니다. 시작 노드와 함께 지정합니다."
              },
              "flow_start_node_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Flow Start Node Id",
                "description": "Flow 실행 시작 노드입니다."
              },
              "dynamic_variables": {
                "anyOf": [
                  {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Dynamic Variables",
                "description": "Dynamic variables made available to the agent during a call."
              },
              "tool_mocks": {
                "anyOf": [
                  {
                    "items": {
                      "additionalProperties": true,
                      "type": "object"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Tool Mocks",
                "description": "API/MCP mock 설정입니다. eval-schema/tool-mocks/v1 계약을 사용합니다."
              },
              "custom_properties": {
                "anyOf": [
                  {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Custom Properties"
              }
            },
            "type": "object",
            "required": [
              "name",
              "messages"
            ],
            "title": "CreateUnitTestRequest",
            "additionalProperties": false,
            "examples": [
              {
                "name": "이용 안내 확인",
                "messages": [
                  {
                    "role": "user",
                    "content": "안내 문서를 조회해 주세요."
                  },
                  {
                    "role": "assistant",
                    "content": "",
                    "eval": {
                      "enabled": false
                    },
                    "tool_calls": [
                      {
                        "function_info": {
                          "name": "lookup_document"
                        },
                        "arguments": {
                          "topic": "이용 방법"
                        }
                      }
                    ]
                  },
                  {
                    "role": "tool",
                    "content": "{\"summary\":\"평일에 이용 가능합니다.\"}"
                  },
                  {
                    "role": "assistant",
                    "content": "",
                    "eval": {
                      "enabled": true,
                      "expected_behavior": "조회 결과의 이용 가능일을 안내한다."
                    }
                  }
                ]
              }
            ]
          }
        },
        "required": [
          "mode",
          "payload"
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "type": "string",
            "const": "update"
          },
          "test_id": {
            "type": "string",
            "format": "uuid",
            "title": "Test Id"
          },
          "payload": {
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 255,
                "minLength": 1,
                "title": "Name",
                "description": "Human-readable resource name."
              },
              "description": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Description",
                "description": "Human-readable description."
              },
              "messages": {
                "items": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/UnitTestJudgeMessage"
                    },
                    {
                      "$ref": "#/$defs/UnitTestAssistantMessage"
                    },
                    {
                      "$ref": "#/$defs/ChatEvalUserMessage"
                    },
                    {
                      "$ref": "#/$defs/ChatEvalToolResponseMessage"
                    }
                  ]
                },
                "type": "array",
                "title": "Messages",
                "description": "전체 메시지 배열을 교체합니다. Flow transition은 eval.to_node_id로 목적지를 지정합니다."
              },
              "flow_agent_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Flow Agent Id",
                "description": "기존 owner와 같은 값만 허용합니다. owner 변경은 금지합니다."
              },
              "flow_start_node_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Flow Start Node Id"
              },
              "dynamic_variables": {
                "anyOf": [
                  {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Dynamic Variables",
                "description": "Dynamic variables made available to the agent during a call."
              },
              "tool_mocks": {
                "anyOf": [
                  {
                    "items": {
                      "additionalProperties": true,
                      "type": "object"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Tool Mocks"
              },
              "custom_properties": {
                "anyOf": [
                  {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Custom Properties"
              }
            },
            "type": "object",
            "minProperties": 1,
            "title": "UpdateUnitTestRequest",
            "additionalProperties": false,
            "examples": [
              {
                "messages": [
                  {
                    "role": "user",
                    "content": "안내 문서를 조회해 주세요."
                  },
                  {
                    "role": "assistant",
                    "content": "",
                    "eval": {
                      "enabled": false
                    },
                    "tool_calls": [
                      {
                        "function_info": {
                          "name": "lookup_document"
                        },
                        "arguments": {
                          "topic": "이용 방법"
                        }
                      }
                    ]
                  },
                  {
                    "role": "tool",
                    "content": "{\"summary\":\"평일에 이용 가능합니다.\"}"
                  },
                  {
                    "role": "assistant",
                    "content": "",
                    "eval": {
                      "enabled": true,
                      "expected_behavior": "조회 결과의 이용 가능일을 안내한다."
                    }
                  }
                ]
              }
            ]
          }
        },
        "required": [
          "mode",
          "test_id",
          "payload"
        ]
      }
    ],
    "$defs": {
      "UnitTestJudgeMessage": {
        "properties": {
          "role": {
            "type": "string",
            "const": "assistant",
            "title": "Role",
            "description": "메시지 역할입니다. 'assistant'로 고정됩니다."
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "검증 메시지의 내용입니다. 비어 있을 수 있습니다.",
            "default": ""
          },
          "eval": {
            "$ref": "#/$defs/UnitTestEvalMeta"
          },
          "tool_calls": {
            "type": "null",
            "title": "Tool Calls",
            "description": "Judge 메시지에는 도구 호출이 없으므로 항상 null입니다."
          }
        },
        "type": "object",
        "required": [
          "role",
          "eval"
        ],
        "title": "UnitTestJudgeMessage",
        "additionalProperties": false
      },
      "UnitTestEvalMeta": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "description": "해당 메시지의 평가 활성화 여부입니다."
          },
          "expected_behavior": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Behavior",
            "description": "기대되는 에이전트의 응답 행동 설명입니다.",
            "default": ""
          },
          "expected_kind": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "message",
                  "tool_call",
                  "transition"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Kind",
            "description": "Flow 검사 종류입니다. transition은 eval.to_node_id로 목적지를 지정하고, tool_call은 expected_behavior로 판정합니다."
          },
          "to_node_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "To Node Id",
            "description": "Flow의 활성 transition 기대 목적지입니다. null/빈값은 invalid 초안으로 저장됩니다. tool_calls와 함께 명시할 수 없습니다."
          }
        },
        "type": "object",
        "required": [
          "enabled"
        ],
        "title": "UnitTestEvalMeta",
        "additionalProperties": false
      },
      "UnitTestAssistantMessage": {
        "properties": {
          "role": {
            "type": "string",
            "const": "assistant",
            "title": "Role",
            "description": "메시지 역할입니다. 'assistant'로 고정됩니다."
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "어시스턴트의 응답 내용입니다."
          },
          "eval": {
            "$ref": "#/$defs/UnitTestEvalMeta"
          },
          "tool_calls": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/$defs/ToolCall"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Calls",
            "description": "어시스턴트가 요청한 도구 호출 목록입니다."
          }
        },
        "type": "object",
        "required": [
          "role",
          "content",
          "eval"
        ],
        "title": "UnitTestAssistantMessage",
        "additionalProperties": false
      },
      "ToolCall": {
        "properties": {
          "arguments": {
            "additionalProperties": true,
            "type": "object",
            "title": "Arguments",
            "description": "도구 호출에 전달할 인자 목록입니다. StartManual의 id는 소문자·하이픈을 포함한 canonical Manual UUID입니다."
          },
          "function_info": {
            "$ref": "#/$defs/ToolCallFunctionInfo",
            "description": "호출할 도구 함수의 정보입니다."
          }
        },
        "type": "object",
        "required": [
          "arguments",
          "function_info"
        ],
        "title": "ToolCall",
        "description": "도구 호출 정보",
        "additionalProperties": false
      },
      "ToolCallFunctionInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "호출할 도구의 함수 이름입니다. Manual 이력은 정확히 StartManual로 작성합니다."
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "ToolCallFunctionInfo",
        "description": "도구 호출 함수 정보",
        "additionalProperties": false
      },
      "ChatEvalUserMessage": {
        "properties": {
          "role": {
            "type": "string",
            "const": "user",
            "title": "Role",
            "description": "메시지 역할입니다. 'user'로 고정됩니다."
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "사용자의 발화 내용입니다."
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatEvalUserMessage",
        "description": "메시지 타입 2: 유저 메시지",
        "additionalProperties": false
      },
      "ChatEvalToolResponseMessage": {
        "properties": {
          "role": {
            "type": "string",
            "const": "tool",
            "title": "Role",
            "description": "메시지 역할입니다. 'tool'로 고정됩니다."
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "도구 실행 결과 문자열입니다. StartManual은 중복 key·비표준 숫자 없는 JSON 객체이며 status는 loaded/already_loaded/rejected/error입니다. 성공 manual_id는 호출 id와 같아야 하고 실패는 생략/null/동일 id를 허용합니다."
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatEvalToolResponseMessage",
        "description": "메시지 타입 3: 도구 응답 메시지",
        "additionalProperties": false
      }
    }
  }
