                    "type": "null"
                  }
                ],
                "title": "Dynamic Variables",
                "description": "실행할 때 에이전트에 넣을 동적 변수입니다."
              },
              "tool_mocks": {
                "anyOf": [
                  {
                    "items": {
                      "oneOf": [
                        {
                          "$ref": "#/$defs/EvalApiToolMock"
                        },
                        {
                          "$ref": "#/$defs/EvalMcpToolMock"
                        },
                        {
                          "$ref": "#/$defs/EvalFlowApiToolMock"
